#Using Gemini API for AI functionalities
GEMINI_API_KEY=your_api_key_here
AI_MODEL=AI_Model_Of_your_Choice

# Server Configuration
PORT=5000
FLASK_ENV=development

# Session Secret (generate it with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# Google OAuth Credentials (replace with your own credentials JSON)
GOOGLE_OAUTH_CREDENTIALS=credentials_json_here